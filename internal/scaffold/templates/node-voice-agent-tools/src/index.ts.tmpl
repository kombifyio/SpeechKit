// {{ .APP_NAME }} - Node.js Voice Agent client with custom tools.
//
// Run with `npm run dev`. Type a message in the terminal to inject a
// user-turn; the agent's transcribed replies print to stdout. When the
// agent calls a registered tool, the tool's result is sent back in a
// tool_response frame.
//
// Frame protocol: https://speechkit.cc/api/asyncapi.v1.yaml

import readline from "node:readline";
import WebSocket, { type RawData } from "ws";

import { tools } from "./tools.js";

const SERVER_URL = process.env["SPEECHKIT_SERVER_URL"] ?? "{{ .SPEECHKIT_SERVER_URL }}";
const TOKEN = process.env["SPEECHKIT_TOKEN"] ?? "{{ .SPEECHKIT_TOKEN }}";
const PERSONA_ID = process.env["SPEECHKIT_PERSONA_ID"] ?? "{{ .PERSONA_ID }}";

interface SessionTicket {
  session_id: string;
  ticket: string;
  ws_url?: string;
}

interface WireFrame {
  type: string;
  text?: string;
  state?: string;
  done?: boolean;
  id?: string;
  name?: string;
  args?: Record<string, unknown>;
  reason?: string;
  code?: string;
  message?: string;
}

async function mintTicket(): Promise<SessionTicket> {
  const headers: Record<string, string> = { "Content-Type": "application/json" };
  if (TOKEN) headers["Authorization"] = `Bearer ${TOKEN}`;
  const response = await fetch(`${SERVER_URL}/v1/voiceagent/sessions`, {
    method: "POST",
    headers,
    body: JSON.stringify({ persona_id: PERSONA_ID }),
  });
  if (!response.ok) {
    throw new Error(`mint ticket failed: HTTP ${response.status} ${await response.text()}`);
  }
  return (await response.json()) as SessionTicket;
}

function deriveWsUrl(ticket: SessionTicket): string {
  if (ticket.ws_url) return ticket.ws_url;
  const wsBase = SERVER_URL.replace(/^http/, "ws");
  return `${wsBase}/v1/voiceagent/sessions/${ticket.session_id}/ws?ticket=${encodeURIComponent(ticket.ticket)}`;
}

async function main(): Promise<void> {
  const ticket = await mintTicket();
  console.log(`session_id=${ticket.session_id}`);

  const ws = new WebSocket(deriveWsUrl(ticket));

  ws.on("open", () => {
    console.log("ws open, sending start...");
    ws.send(
      JSON.stringify({
        type: "start",
        persona_id: PERSONA_ID,
      }),
    );
    promptStdin(ws);
  });

  ws.on("message", async (raw: RawData, isBinary: boolean) => {
    if (isBinary) {
      // Skip server-side audio; this template prints transcripts only.
      return;
    }
    const text = raw.toString("utf-8");
    let frame: WireFrame;
    try {
      frame = JSON.parse(text) as WireFrame;
    } catch (err) {
      console.error("malformed frame", err);
      return;
    }
    await handleFrame(ws, frame);
  });

  ws.on("close", (code, reason) => {
    console.log(`ws closed code=${code} reason=${reason.toString()}`);
    process.exit(0);
  });

  ws.on("error", (err) => {
    console.error("ws error", err);
    process.exit(1);
  });
}

async function handleFrame(ws: WebSocket, frame: WireFrame): Promise<void> {
  switch (frame.type) {
    case "state":
      console.log(`[state] ${frame.state}`);
      break;
    case "input_transcript":
      if (frame.done) console.log(`[user] ${frame.text}`);
      break;
    case "output_transcript":
      if (frame.done) console.log(`[agent] ${frame.text}`);
      break;
    case "tool_call":
      await runTool(ws, frame);
      break;
    case "error":
      console.error(`[error] ${frame.code ?? "?"}: ${frame.message ?? ""}`);
      break;
    case "session_end":
      console.log(`[session_end] ${frame.reason ?? ""}`);
      ws.close();
      break;
  }
}

async function runTool(ws: WebSocket, frame: WireFrame): Promise<void> {
  if (!frame.id || !frame.name) return;
  const tool = tools[frame.name];
  let response: Record<string, unknown>;
  if (!tool) {
    response = { error: `unknown tool: ${frame.name}` };
  } else {
    try {
      response = await tool.invoke(frame.args ?? {});
      console.log(`[tool] ${frame.name} -> ${JSON.stringify(response)}`);
    } catch (err) {
      response = { error: (err as Error).message };
    }
  }
  ws.send(
    JSON.stringify({
      type: "tool_response",
      id: frame.id,
      name: frame.name,
      response,
    }),
  );
}

function promptStdin(ws: WebSocket): void {
  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
    terminal: false,
  });
  rl.on("line", (line) => {
    const text = line.trim();
    if (!text) return;
    if (text === "/quit") {
      ws.send(JSON.stringify({ type: "stop" }));
      ws.close();
      return;
    }
    ws.send(JSON.stringify({ type: "text", text }));
  });
}

main().catch((err) => {
  console.error(err);
  process.exit(1);
});
