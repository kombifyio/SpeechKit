// {{ .APP_NAME }} embeds the SpeechKit Go HTTP client behind a small
// proxy. It exposes:
//
//   POST /transcribe  — multipart audio upload, forwarded to SpeechKit
//   POST /assist      — text in, assist response out
//
// Run with:
//
//   SPEECHKIT_SERVER_URL=http://localhost:8080 \
//   SPEECHKIT_TOKEN=your-token \
//   go run .
package main

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"log/slog"
	"net/http"
	"os"
	"time"

	skclient "github.com/kombifyio/SpeechKit/pkg/speechkit/client"
)

func main() {
	addr := envOr("LISTEN_ADDR", ":8081")
	logger := slog.New(slog.NewJSONHandler(os.Stdout, nil))

	client, err := skclient.New(skclient.Options{
		BaseURL: envOr("SPEECHKIT_SERVER_URL", "{{ .SPEECHKIT_SERVER_URL }}"),
		Token:   envOr("SPEECHKIT_TOKEN", "{{ .SPEECHKIT_TOKEN }}"),
		Timeout: 60 * time.Second,
	})
	if err != nil {
		logger.Error("init speechkit client", "err", err)
		os.Exit(1)
	}

	mux := http.NewServeMux()
	mux.HandleFunc("/healthz", func(w http.ResponseWriter, _ *http.Request) {
		w.WriteHeader(http.StatusOK)
		_, _ = w.Write([]byte(`{"status":"ok"}`))
	})
	mux.HandleFunc("/transcribe", transcribeHandler(client, logger))
	mux.HandleFunc("/assist", assistHandler(client, logger))

	logger.Info("{{ .APP_NAME }} listening", "addr", addr)
	if err := http.ListenAndServe(addr, mux); err != nil { //nolint:gosec // demo server
		logger.Error("listen", "err", err)
		os.Exit(1)
	}
}

func transcribeHandler(client *skclient.Client, logger *slog.Logger) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		if r.Method != http.MethodPost {
			http.Error(w, "POST only", http.StatusMethodNotAllowed)
			return
		}
		ctx, cancel := context.WithTimeout(r.Context(), 60*time.Second)
		defer cancel()

		const maxAudio = 25 << 20 // 25 MB
		if err := r.ParseMultipartForm(maxAudio); err != nil {
			http.Error(w, "invalid multipart: "+err.Error(), http.StatusBadRequest)
			return
		}
		file, header, err := r.FormFile("audio")
		if err != nil {
			http.Error(w, "audio field required", http.StatusBadRequest)
			return
		}
		defer file.Close() //nolint:errcheck // request body close

		tmp, err := os.CreateTemp("", "speechkit-upload-*"+sanitizeExt(header.Filename))
		if err != nil {
			http.Error(w, "temp file: "+err.Error(), http.StatusInternalServerError)
			return
		}
		defer os.Remove(tmp.Name()) //nolint:errcheck // cleanup
		defer tmp.Close()           //nolint:errcheck // cleanup
		if _, err := io.Copy(tmp, file); err != nil {
			http.Error(w, "save upload: "+err.Error(), http.StatusInternalServerError)
			return
		}
		if err := tmp.Close(); err != nil {
			http.Error(w, "close upload: "+err.Error(), http.StatusInternalServerError)
			return
		}

		result, err := client.TranscribeFile(ctx, tmp.Name(), skclient.TranscribeOptions{
			Language: r.FormValue("language"),
			Model:    r.FormValue("model"),
		})
		if err != nil {
			logger.Error("transcribe", "err", err)
			respondError(w, err)
			return
		}
		respondJSON(w, http.StatusOK, result)
	}
}

func assistHandler(client *skclient.Client, logger *slog.Logger) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		if r.Method != http.MethodPost {
			http.Error(w, "POST only", http.StatusMethodNotAllowed)
			return
		}
		ctx, cancel := context.WithTimeout(r.Context(), 60*time.Second)
		defer cancel()

		var payload map[string]any
		if err := json.NewDecoder(r.Body).Decode(&payload); err != nil {
			http.Error(w, "invalid json: "+err.Error(), http.StatusBadRequest)
			return
		}
		raw, err := client.RawJSON(ctx, http.MethodPost, "/v1/assist/process", payload)
		if err != nil {
			logger.Error("assist", "err", err)
			respondError(w, err)
			return
		}
		w.Header().Set("Content-Type", "application/json")
		_, _ = w.Write(raw)
	}
}

func respondJSON(w http.ResponseWriter, code int, body any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(code)
	_ = json.NewEncoder(w).Encode(body)
}

func respondError(w http.ResponseWriter, err error) {
	var httpErr skclient.HTTPError
	if errors.As(err, &httpErr) {
		http.Error(w, fmt.Sprintf("upstream %d: %s", httpErr.StatusCode, httpErr.Body), httpErr.StatusCode)
		return
	}
	http.Error(w, err.Error(), http.StatusBadGateway)
}

func envOr(key, fallback string) string {
	if v, ok := os.LookupEnv(key); ok && v != "" {
		return v
	}
	return fallback
}

func sanitizeExt(name string) string {
	ext := ""
	for i := len(name) - 1; i >= 0 && i > len(name)-8; i-- {
		if name[i] == '.' {
			ext = name[i:]
			break
		}
	}
	if ext == "" {
		return ".bin"
	}
	return ext
}
