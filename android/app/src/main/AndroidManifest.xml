<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <package android:name="io.kombify.ai" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- allowBackup=false: the app persists server bearer tokens in
         SharedPreferences; auto-backup would let them ride device migrations
         in plaintext. Revisit with encrypted storage + extraction rules.
         usesCleartextTraffic: the documented LAN tier talks plain http/ws to
         a local speechkit-server (e.g. http://192.168.x.x:8080); with
         targetSdk 36 cleartext is otherwise blocked at runtime. Android's
         networkSecurityConfig cannot express RFC1918 CIDR, only hostnames, so
         a "private range" config would break the LAN finder. Keep cleartext
         until the homelab path uses TLS or a resolvable name; Play submission
         still needs that, not a fake domain list. -->
    <application
        android:name=".app.SpeechKitApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpeechKit"
        tools:replace="android:name,android:label,android:allowBackup">

        <!-- The Stage-1 voice-only IME is not a typing keyboard. Leaving it
             registered put a second SpeechKit entry in the system picker and
             onboarding kept selecting it. Dictation and the voice agent live
             inside LatinIME; hop-from-another-keyboard is no longer a product
             path. -->
        <service
            android:name="io.kombify.speechkit.ime.SpeechKitVoiceImeService"
            tools:node="remove" />

        <!-- The keyboard fork ships its own launcher icon, which is right for
             a standalone keyboard and wrong here: merged into this app it put
             a second "kombify SpeechKit" icon in the launcher, opening the
             keyboard's settings instead of the app. Verified on an emulator -
             both io.kombify.speechkit/.app.ui.MainActivity and
             .../helium314.keyboard.settings.SettingsActivity answered
             MAIN/LAUNCHER. Removed here rather than in the fork so the fork
             keeps building and running standalone exactly as upstream does;
             the activity itself stays, reachable from the keyboard's own
             settings key. -->
        <activity
            android:name="helium314.keyboard.settings.SettingsActivity"
            tools:node="merge">
            <intent-filter tools:node="removeAll" />
        </activity>

        <!-- Main Activity -->
        <activity
            android:name=".app.ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SpeechKit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="speechkit"
                    android:host="connect" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="speechkit.kombify.io"
                    android:pathPrefix="/connect" />
            </intent-filter>
        </activity>

        <!-- Share a voice note from WhatsApp/Telegram (or pick a file from
             the keyboard more-page) and get a transcript. The alias is a
             second share-sheet entry that summarises via Assist. -->
        <activity
            android:name=".app.keyboard.TranscribeAudioActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/shortcut_transcribe_audio"
            android:theme="@style/Theme.SpeechKit">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".app.keyboard.SummarizeAudioAlias"
            android:exported="true"
            android:targetActivity=".app.keyboard.TranscribeAudioActivity"
            android:label="@string/shortcut_summarize_audio">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
        </activity-alias>

        <!-- Voice Assistant -->
        <service
            android:name=".assistant.service.SpeechKitAssistant"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction" />
        </service>

        <!-- Session service class lives in SpeechKitAssistantSession.kt but is
             named SpeechKitAssistantSessionService; the earlier manifest
             referenced the file name and could never bind. -->
        <service
            android:name=".assistant.service.SpeechKitAssistantSessionService"
            android:exported="false"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- ROLE_ASSISTANT qualification requires a RecognitionService even
             though the overlay session captures its own audio. -->
        <service
            android:name=".assistant.service.SpeechKitRecognitionService"
            android:exported="true"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

    </application>

</manifest>
