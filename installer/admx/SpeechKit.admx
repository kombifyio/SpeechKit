<?xml version="1.0" encoding="utf-8"?>
<!--
  SpeechKit.admx — Group Policy administrative template for kombify SpeechKit.

  Registry layout:
    HKLM\SOFTWARE\Policies\kombify\SpeechKit\   (locked by GPO — highest priority)
    HKLM\SOFTWARE\kombify\SpeechKit\            (admin defaults — user-overridable)
    HKCU\Software\kombify\SpeechKit\            (user-only prefs — lowest priority)

  Loader precedence (highest → lowest):
    HKLM Policies → HKLM Defaults → config.toml → HKCU → env vars

  Install path: %SystemRoot%\PolicyDefinitions\SpeechKit.admx
    + en-US\SpeechKit.adml (and/or other locale subdirectories)

  For domain-wide GPO deployment via the Central Store, see:
    docs/runbooks/admx-deployment.md
-->
<policyDefinitions
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    revision="1.0"
    schemaVersion="1.0"
    xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">

  <policyNamespaces>
    <target prefix="speechkit" namespace="kombify.SpeechKit.Policies" />
    <using prefix="windows" namespace="Microsoft.Policies.Windows" />
  </policyNamespaces>

  <resources minRequiredRevision="1.0" />

  <categories>
    <category name="KombifyCat" displayName="$(string.KombifyCat)" />
    <category name="SpeechKitCat" displayName="$(string.SpeechKitCat)">
      <parentCategory ref="KombifyCat" />
    </category>
    <category name="SpeechKitUpdateCat" displayName="$(string.SpeechKitUpdateCat)">
      <parentCategory ref="SpeechKitCat" />
    </category>
    <category name="SpeechKitTelemetryCat" displayName="$(string.SpeechKitTelemetryCat)">
      <parentCategory ref="SpeechKitCat" />
    </category>
    <category name="SpeechKitProvidersCat" displayName="$(string.SpeechKitProvidersCat)">
      <parentCategory ref="SpeechKitCat" />
    </category>
    <category name="SpeechKitVoiceAgentCat" displayName="$(string.SpeechKitVoiceAgentCat)">
      <parentCategory ref="SpeechKitCat" />
    </category>
    <category name="SpeechKitAuditCat" displayName="$(string.SpeechKitAuditCat)">
      <parentCategory ref="SpeechKitCat" />
    </category>
  </categories>

  <policies>

    <!-- ═══════════════════════════════════════════════════════════════════
         Update policies
         Registry key: HKLM\SOFTWARE\Policies\kombify\SpeechKit\Update
    ════════════════════════════════════════════════════════════════════ -->

    <policy
        name="UpdateEnabled"
        class="Machine"
        displayName="$(string.UpdateEnabled)"
        explainText="$(string.UpdateEnabled_explain)"
        key="Software\Policies\kombify\SpeechKit\Update"
        valueName="Enabled">
      <parentCategory ref="SpeechKitUpdateCat" />
      <supportedOn ref="windows:SUPPORTED_Windows10" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <policy
        name="UpdateManifestURL"
        class="Machine"
        displayName="$(string.UpdateManifestURL)"
        explainText="$(string.UpdateManifestURL_explain)"
        key="Software\Policies\kombify\SpeechKit\Update">
      <parentCategory ref="SpeechKitUpdateCat" />
      <supportedOn ref="windows:SUPPORTED_Windows10" />
      <elements>
        <text id="UpdateManifestURL_Text" valueName="ManifestURL" required="true" maxLength="500" />
      </elements>
    </policy>

    <!-- ═══════════════════════════════════════════════════════════════════
         Telemetry policies
         Registry key: HKLM\SOFTWARE\Policies\kombify\SpeechKit\Telemetry
    ════════════════════════════════════════════════════════════════════ -->

    <policy
        name="TelemetryUpdateCheck"
        class="Machine"
        displayName="$(string.TelemetryUpdateCheck)"
        explainText="$(string.TelemetryUpdateCheck_explain)"
        key="Software\Policies\kombify\SpeechKit\Telemetry"
        valueName="UpdateCheck">
      <parentCategory ref="SpeechKitTelemetryCat" />
      <supportedOn ref="windows:SUPPORTED_Windows10" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- ═══════════════════════════════════════════════════════════════════
         Providers policies
         Registry key: HKLM\SOFTWARE\Policies\kombify\SpeechKit\Providers
    ════════════════════════════════════════════════════════════════════ -->

    <policy
        name="ProvidersEnforceLocalOnly"
        class="Machine"
        displayName="$(string.ProvidersEnforceLocalOnly)"
        explainText="$(string.ProvidersEnforceLocalOnly_explain)"
        key="Software\Policies\kombify\SpeechKit\Providers"
        valueName="EnforceLocalOnly">
      <parentCategory ref="SpeechKitProvidersCat" />
      <supportedOn ref="windows:SUPPORTED_Windows10" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- ═══════════════════════════════════════════════════════════════════
         Voice Agent policies
         Registry key: HKLM\SOFTWARE\Policies\kombify\SpeechKit\VoiceAgent
    ════════════════════════════════════════════════════════════════════ -->

    <policy
        name="VoiceAgentAllowCloudProviders"
        class="Machine"
        displayName="$(string.VoiceAgentAllowCloudProviders)"
        explainText="$(string.VoiceAgentAllowCloudProviders_explain)"
        key="Software\Policies\kombify\SpeechKit\VoiceAgent"
        valueName="AllowCloudProviders">
      <parentCategory ref="SpeechKitVoiceAgentCat" />
      <supportedOn ref="windows:SUPPORTED_Windows10" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- ═══════════════════════════════════════════════════════════════════
         Audit policies
         Registry key: HKLM\SOFTWARE\Policies\kombify\SpeechKit\Audit
    ════════════════════════════════════════════════════════════════════ -->

    <policy
        name="AuditRetentionDays"
        class="Machine"
        displayName="$(string.AuditRetentionDays)"
        explainText="$(string.AuditRetentionDays_explain)"
        key="Software\Policies\kombify\SpeechKit\Audit">
      <parentCategory ref="SpeechKitAuditCat" />
      <supportedOn ref="windows:SUPPORTED_Windows10" />
      <elements>
        <decimal id="AuditRetentionDays_Value" valueName="RetentionDays" minValue="1" maxValue="3650" />
      </elements>
    </policy>

    <policy
        name="AuditEventLogEnabled"
        class="Machine"
        displayName="$(string.AuditEventLogEnabled)"
        explainText="$(string.AuditEventLogEnabled_explain)"
        key="Software\Policies\kombify\SpeechKit\Audit"
        valueName="EventLogEnabled">
      <parentCategory ref="SpeechKitAuditCat" />
      <supportedOn ref="windows:SUPPORTED_Windows10" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <policy
        name="AuditOTLPEndpoint"
        class="Machine"
        displayName="$(string.AuditOTLPEndpoint)"
        explainText="$(string.AuditOTLPEndpoint_explain)"
        key="Software\Policies\kombify\SpeechKit\Audit">
      <parentCategory ref="SpeechKitAuditCat" />
      <supportedOn ref="windows:SUPPORTED_Windows10" />
      <elements>
        <text id="AuditOTLPEndpoint_Text" valueName="OTLPEndpoint" required="true" maxLength="500" />
      </elements>
    </policy>

  </policies>
</policyDefinitions>
