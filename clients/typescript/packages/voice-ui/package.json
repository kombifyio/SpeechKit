{
  "name": "@kombifyio/speechkit-voice-ui",
  "version": "0.65.0",
  "description": "Framework-neutral SpeechKit voice UI kit: custom elements (split button, voice-agent overlay, visualizer, consent), design tokens, and the speechkit.voice_ui.v1 behavior spec.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    "./voiceagent-adapter": {
      "types": "./dist/adapters/voiceagent.d.ts",
      "default": "./dist/adapters/voiceagent.js"
    },
    "./marks": {
      "types": "./dist/marks.d.ts",
      "default": "./dist/marks.js"
    },
    "./tokens.json": "./src/tokens/tokens.json",
    "./tokens.css": "./src/tokens/tokens.css",
    "./locales/*": "./locales/*"
  },
  "files": [
    "dist",
    "src/tokens",
    "locales",
    "spec",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/define.js",
    "./dist/cdn/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kombifyio/SpeechKit.git",
    "directory": "clients/typescript/packages/voice-ui"
  },
  "homepage": "https://github.com/kombifyio/SpeechKit#readme",
  "bugs": {
    "url": "https://github.com/kombifyio/SpeechKit/issues"
  },
  "keywords": [
    "speechkit",
    "kombify",
    "voice",
    "web-components",
    "custom-elements",
    "dictation",
    "voice-agent",
    "design-tokens"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:locales": "node scripts/emit-locale-json.mjs",
    "build": "node scripts/build-tokens.mjs --check && tsc -p tsconfig.json && node scripts/emit-locale-json.mjs --check && node scripts/build-cdn.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/check-contract-drift.mjs && vitest run"
  },
  "peerDependencies": {
    "@kombifyio/speechkit-voiceagent-client": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "@kombifyio/speechkit-voiceagent-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kombifyio/speechkit-voiceagent-client": "workspace:*",
    "@types/node": "^22.19.17",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.8.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
