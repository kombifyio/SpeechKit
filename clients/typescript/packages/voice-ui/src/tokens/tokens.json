{
  "$schema": "https://kombify.io/schemas/speechkit-voice-ui-tokens.v1.json",
  "version": "speechkit.voice_ui.v1",
  "prefix": "--sk-",
  "description": "Design tokens for the SpeechKit Voice UI Kit. Machine-readable SSOT: tokens.css is generated from this file (scripts/build-tokens.mjs); the Compose implementation maps these values to its native theme.",
  "themes": {
    "light": {
      "accent": "oklch(0.65 0.13 210)",
      "accent-contrast": "#ffffff",
      "surface": "color-mix(in srgb, #ffffff 72%, transparent)",
      "surface-strong": "color-mix(in srgb, #ffffff 92%, transparent)",
      "text": "#101418",
      "text-muted": "color-mix(in srgb, #101418 55%, transparent)",
      "border": "color-mix(in srgb, #101418 12%, transparent)",
      "shadow": "0 12px 40px -12px rgba(16, 20, 24, 0.25)",
      "live": "#dc2626"
    },
    "dark": {
      "accent": "oklch(0.72 0.12 210)",
      "accent-contrast": "#0b1014",
      "surface": "color-mix(in srgb, #14181d 68%, transparent)",
      "surface-strong": "color-mix(in srgb, #14181d 90%, transparent)",
      "text": "#f2f5f7",
      "text-muted": "color-mix(in srgb, #f2f5f7 60%, transparent)",
      "border": "color-mix(in srgb, #f2f5f7 14%, transparent)",
      "shadow": "0 12px 40px -12px rgba(0, 0, 0, 0.6)",
      "live": "#f87171"
    }
  },
  "shared": {
    "blur": "16px",
    "radius": "14px",
    "radius-pill": "999px",
    "gap": "8px",
    "font-size": "13px",
    "font-size-small": "11px",
    "motion-fast": "80ms",
    "motion-slow": "1600ms",
    "orb-size": "56px",
    "orb-core-size": "22px",
    "assistant-orb": "30px",
    "assistant-orb-watch": "84px",
    "assistant-orb-hero": "92px",
    "assistant-mark-ratio": "34%",
    "assistant-user-dot": "#8fa9ff",
    "assistant-agent-dot": "#47e3c1",
    "aura-inactive-a": "156, 163, 184",
    "aura-inactive-b": "100, 116, 139",
    "aura-connecting-a": "56, 189, 248",
    "aura-connecting-b": "129, 140, 248",
    "aura-listening-a": "52, 211, 153",
    "aura-listening-b": "56, 189, 248",
    "aura-processing-a": "251, 191, 36",
    "aura-processing-b": "244, 114, 182",
    "aura-speaking-a": "129, 140, 248",
    "aura-speaking-b": "167, 139, 250",
    "aura-recovering-a": "34, 211, 238",
    "aura-recovering-b": "129, 140, 248",
    "aura-settling-a": "52, 211, 153",
    "aura-settling-b": "129, 140, 248",
    "aura-error-a": "248, 113, 113",
    "aura-error-b": "251, 113, 133"
  },
  "visualizer": {
    "level-scale-max": 0.85,
    "states": {
      "idle": { "animation": "none" },
      "connecting": { "animation": "breathe", "duration": "1200ms", "opacity-low": 0.4 },
      "listening": { "animation": "breathe", "duration": "1600ms", "opacity-low": 0.55 },
      "processing": { "animation": "breathe", "duration": "900ms", "opacity-low": 0.55, "opacity": 0.75 },
      "speaking": { "animation": "pulse", "duration": "800ms" },
      "error": { "animation": "none", "opacity": 0.5 }
    },
    "reduced-motion": "static state indicator, no animation, no level transform"
  },
  "assistant": {
    "description": "speechkit-voice-assistant (Aura Orb, decision 2026-08-10). Non-CSS spec metadata: the SSOT for native parity ports (Jetpack Compose on Android, LVGL on kombify-box). `level` is the smoothed 0..1 speech level (fast-rise attack 0.55/tick, exponential release 5/s). Per-state colours are the aura-<state>-a/-b token pairs (RGB triplets: `a` leads the glow/halo/spark, `b` is the second sweep stop).",
    "layers": [
      { "id": "glow", "inset": "0%", "paint": "radial-gradient(circle at 50% 50%, rgba(a,0.38), rgba(a,0.08) 55%, rgba(a,0) 72%)", "animation": "breathe 4.5s ease-in-out infinite" },
      { "id": "sweep", "inset": "6%", "opacity": 0.9, "blur": "6px", "paint": "conic-gradient(from 0deg, rgba(a,0) 0deg, rgba(a,0.55) 90deg, rgba(b,0) 200deg, rgba(b,0.45) 300deg, rgba(a,0) 360deg)", "animation": "spin 9s linear infinite" },
      { "id": "sweep-inner", "inset": "16%", "opacity": 0.8, "blur": "4px", "paint": "conic-gradient(from 180deg, rgba(b,0) 0deg, rgba(b,0.4) 120deg, rgba(a,0) 260deg)", "animation": "spin -13s linear infinite (counter-rotating)" },
      { "id": "halo", "inset": "10%", "paint": "1px border rgba(a,0.5); shadow 0 0 18px rgba(a,0.35) inset, 0 0 12px rgba(b,0.28)", "level": "scale = 0.82 + level*0.3; opacity = 0.35 + level*0.5", "transition": "transform 120ms ease-out, opacity 200ms ease-out" },
      { "id": "core", "inset": "26%", "paint": "radial-gradient(circle at 38% 32%, rgba(255,255,255,0.30), rgba(255,255,255,0.06) 46%, rgba(255,255,255,0.02) 70%); 1px border rgba(255,255,255,0.14); backdrop blur 2px", "animation": "core 3.2s ease-in-out infinite (opacity 0.78..1)" },
      { "id": "spark", "size": "12% centred", "paint": "radial-gradient(circle, rgba(a,0.95), rgba(a,0.2) 70%, rgba(a,0) 100%)", "opacity": 0.85 },
      { "id": "mark", "size": "assistant-mark-ratio (34%)", "paint": "host brand image; kit ships none" }
    ],
    "states": {
      "_doc": "`active: false` states are at rest: every layer animation stops, halo opacity pins to 0.18 with thinned shadows, spark drops to 0.4, and the mark desaturates (grayscale(1) brightness(0.95), opacity 0.5, no level scale).",
      "inactive": { "active": false },
      "connecting": { "active": true },
      "listening": { "active": true },
      "processing": { "active": true },
      "speaking": { "active": true },
      "recovering": { "active": true, "note": "host FSM state; no surface-contract equivalent" },
      "settling": { "active": true, "note": "host FSM state; no surface-contract equivalent" },
      "error": { "active": false }
    },
    "status-mapping": {
      "_doc": "Default session status -> aura state. Hosts with a richer FSM override via the aura-state attribute.",
      "idle": "inactive",
      "connecting": "connecting",
      "capturing": "listening",
      "processing": "processing",
      "speaking": "speaking",
      "cancelled": "inactive",
      "denied": "error"
    },
    "mark-when-active": {
      "filter": "saturate(1.15) drop-shadow(0 0 (4 + level*12)px rgba(a, 0.35 + level*0.4))",
      "transform": "scale(1 + level*0.08)",
      "transition": "filter/opacity/transform 420ms ease"
    },
    "chrome": {
      "status-dot-pulse": "1.2s ease-in-out infinite while capturing/speaking",
      "tone": "rgb(a) — drives the compact status dot and the draft caret"
    },
    "reduced-motion": "no spin/breathe/core/pulse animation and no level transforms; per-state colours and the resting/active mark treatment remain"
  }
}
