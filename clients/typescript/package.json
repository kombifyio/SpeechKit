{
  "name": "@kombifyio/speechkit-typescript-clients",
  "version": "0.68.54",
  "private": true,
  "description": "pnpm workspace for the OSS SpeechKit TypeScript client packages.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "pack:smoke": "node scripts/npm-consumer-smoke.mjs",
    "release:readiness": "node scripts/npm-public-readiness.mjs",
    "release:test": "node --test scripts/npm-public-readiness.test.mjs scripts/npm-publish-idempotent.test.mjs",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
