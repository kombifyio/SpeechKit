# SpeechKit — multi-stage Linux container build.
#
#   docker build -f deploy/docker/Dockerfile.server \
#     --target speechkit-server-selfhosted -t speechkit-server:dev .
#
# Targets: speechkit-server-selfhosted is the published self-host image with
# the bundled Phonon-2.5 speech-to-text model; speechkit-server (the last
# stage, so also the default) is the same server without a bundled model, the
# one kombify's hosted production and Early Access build.
#
# The server is the central Framework wrapper: Dictation REST, Assist REST,
# and Voice Agent WebSocket are exposed by one reusable HTTP/WebSocket adapter.
#
# Run locally:
#   docker run --rm -p 8080:8080 \
#     -e ASSEMBLYAI_API_KEY \
#     -v speechkit-models:/var/lib/speechkit/models \
#     -v "$(pwd)/deploy/config/server.example.toml:/etc/speechkit/config.toml:ro" \
#     speechkit-server:dev

# ── Stage 1: Go builder ──────────────────────────────────────────────────────
# Audit 3.2: digest-pin the base. Dependabot's docker ecosystem
# auto-updates the @sha256:... value when upstream tags rebuild. The
# tag stays in the line so humans (and Dependabot's image: matcher)
# can read what version this resolves to.
FROM golang:1.27.3-bookworm@sha256:21ade014faf952365b9ecbd8dbdb87176fbacb82fac9fb132d9f2a7b8cc3f132 AS builder

# ONNX Runtime, oto/v3 (ALSA on Linux via pkg-config), and LiveKit PCM/Opus
# media bridging need a host compiler plus development headers at build time.
# The actual libonnxruntime.so is copied into the runtime stage, not here.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        libc6-dev \
        libasound2-dev \
        libopus-dev \
        libopusfile-dev \
        libsoxr-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Pre-cache modules for faster iterative builds.
# The reference apps are the nested module app/ (docs/ADR/0004); go.work joins
# it with the root SDK module, so copy every module manifest before downloading.
COPY go.mod go.sum go.work go.work.sum ./
COPY app/go.mod app/go.sum ./app/
COPY pkg/speechkit/x/go.mod pkg/speechkit/x/go.sum ./pkg/speechkit/x/
COPY examples/go.mod examples/go.sum ./examples/
RUN go mod download

# Pull in the full source tree — we rely on the `//go:build linux` tag on the
# server-target files to skip any Windows-only files during compile.
COPY . .

# Static-ish build with stripped symbols. CGO is enabled because the Framework
# kernel pulls in the Silero VAD ONNX runtime.
ARG VERSION=dev
# Exact source commit of the build; the server reports it as its release.
ARG SOURCE_SHA=
ENV CGO_ENABLED=1 \
    GOOS=linux \
    GOARCH=amd64

RUN go build \
        -tags=server \
        -ldflags="-s -w -X main.version=${VERSION} -X main.sourceSHA=${SOURCE_SHA}" \
        -o /out/speechkit-server \
        ./app/cmd/speechkit-server

# Parakeet speech-to-text sidecar (speechkit-stt-sherpa). It links the
# sherpa-onnx libraries the go.sum-pinned sherpa-onnx-go-linux module ships,
# which bring their own ONNX Runtime. They go to a private directory found
# through the binary's runpath, never into /usr/local/lib, so they cannot
# shadow the ONNX Runtime 1.17.1 the server loads for Silero VAD.
RUN go build \
        -ldflags="-s -w -X main.version=${VERSION} -extldflags=-Wl,-rpath,/usr/local/lib/sherpa-onnx" \
        -o /out/speechkit-stt-sherpa \
        ./app/cmd/speechkit-stt-sherpa \
    && mkdir -p /out/sherpa-onnx \
    && cp "$(go list -m -f '{{.Dir}}' github.com/k2-fsa/sherpa-onnx-go-linux)/lib/x86_64-unknown-linux-gnu/"*.so /out/sherpa-onnx/

# ── Stage 1b: bundled local speech-to-text model (self-hosted image only) ───
# Phonon-2.5 (Fermion Research, CC-BY-4.0; 25 languages, 178 MB five-value
# container) is the self-hosted install's local STT: with no STT endpoint and
# no cloud key, the server runs speechkit-stt-sherpa on it
# (config.bundledServerSTTDefault). Only the speechkit-server-selfhosted target
# copies it; BuildKit skips this stage for every other target, so the
# production image neither carries the model nor fetches anything here.
#
# Pins: the same revision and SHA-256 values as the desktop download catalog
# (app/host/downloads/catalog_artifacts.go, parakeet.phonon-2.5), the Windows
# installer (scripts/prepare-phonon-model.ps1) and the phonon profile of
# docker-compose.local-only.yml; scripts/ci/check-phonon-pins.sh fails the
# SpeechKit gate when any of the four disagree. The archive is checked against
# Fermion's SHA256SUMS entry, then every unpacked file against the catalog pin.
# Fermion's NOTICE and the CC-BY-4.0 legal code travel with the model.
FROM debian:bookworm-slim@sha256:0104b334637a5f19aa9c983a91b54c89887c0984081f2068983107a6f6c21eeb AS phonon-model

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl zstd \
    && rm -rf /var/lib/apt/lists/*

# Plain curl, tar and WORKDIR only: the Delivery download guard admits a
# Dockerfile whose RUN steps it can read, and a shell function, cd or a bare
# zstd call is not one of them (D-2026-10-25-03).
WORKDIR /out/phonon-2.5

RUN set -eux; \
    base=https://huggingface.co/FermionResearch/Phonon-2.5/resolve/2673618ad8636c8dfd20fe57e94d1f67f75bdeaa; \
    curl -fL --retry 5 --retry-all-errors --retry-delay 3 --connect-timeout 30 -o /tmp/phonon-2.5.tar.zst "$base/phonon-2.5.bps.tar.zst"; \
    echo '1faa04053a472cabab3bc31d07f30c23f22906f71044ca10eb1f0de36d1f19a9  /tmp/phonon-2.5.tar.zst' | sha256sum -c -; \
    tar --zstd -xf /tmp/phonon-2.5.tar.zst model.fermion config.json packed_manifest.json; \
    rm /tmp/phonon-2.5.tar.zst; \
    curl -fL --retry 5 --retry-all-errors --retry-delay 3 --connect-timeout 30 -o NOTICE "$base/NOTICE"; \
    curl -fL --retry 5 --retry-all-errors --retry-delay 3 --connect-timeout 30 -o LICENSE "$base/LICENSE-WEIGHTS-CC-BY-4.0.txt"; \
    printf '%s  %s\n' \
      17cb62d08e751a41819eb779db089aa7ac4eb2bab433ba5c2991d8cbd3cfefb9 model.fermion \
      b8ee2310784b2ffb62200bc9d2301cdc0576141ee9c53f7a41a5a2d181910cc9 config.json \
      2c98e5d0e1349fa146f21cdc168d681b186711c78abcfac47af16c25649f5c89 packed_manifest.json \
      dd4993badd45eb336280a0ab5b4ecb3ed06260d189a30fcae8b9e89a587c4de8 NOTICE \
      9ba9550ad48438d0836ddab3da480b3b69ffa0aac7b7878b5a0039e7ab429411 LICENSE \
      | sha256sum -c -; \
    chmod 0644 ./*

# ── Stage 2: Shared runtime base ─────────────────────────────────────────────
# Keeping this as a separate stage keeps apt + ONNX install layers stable
# across rebuilds.
# Audit 3.2: digest-pin the runtime base. See builder stage for the
# Dependabot rationale.
FROM debian:bookworm-slim@sha256:0104b334637a5f19aa9c983a91b54c89887c0984081f2068983107a6f6c21eeb AS runtime-base

# Runtime dependencies:
#  - ca-certificates: TLS trust for all cloud provider calls
#  - ffmpeg: audio format decode for WebM-Opus / OGG-Opus ingress
#  - libgomp1: OpenMP runtime required by ONNX Runtime + whisper.cpp
#  - libasound2: ALSA runtime. oto/v3 links against libasound at build time
#                via cgo; even though the server never plays audio locally,
#                the linker requires the .so to resolve symbols at start.
#  - libopus0/libopusfile0/libsoxr0: runtime libraries for the LiveKit
#                PCM/Opus bridge.
#  - curl: for optional model download on first boot and health probes
RUN apt-get update \
    && apt-get -y upgrade \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        libgomp1 \
        libasound2 \
        libopus0 \
        libopusfile0 \
        libsoxr0 \
        curl \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# ONNX Runtime shared lib for the Silero VAD kernel. Pinned version must stay
# in sync with `github.com/yalue/onnxruntime_go` in go.mod.
ARG ONNX_VERSION=1.17.1
# Download to a file with retries instead of streaming `curl | tar`: a piped
# stream that drops mid-transfer (a recurring GitHub-release-asset flake)
# would otherwise fail the whole release build with no retry. --retry-all-errors
# also retries on transient 5xx/connection resets, not just curl's own errors.
RUN set -eux; \
    curl -fL --retry 5 --retry-all-errors --retry-delay 3 --connect-timeout 30 \
      -o /tmp/onnxruntime.tgz \
      "https://github.com/microsoft/onnxruntime/releases/download/v${ONNX_VERSION}/onnxruntime-linux-x64-${ONNX_VERSION}.tgz"; \
    tar -xzf /tmp/onnxruntime.tgz -C /tmp; \
    cp -a "/tmp/onnxruntime-linux-x64-${ONNX_VERSION}/lib/." /usr/local/lib/; \
    ldconfig; \
    rm -rf /tmp/onnxruntime.tgz "/tmp/onnxruntime-linux-x64-${ONNX_VERSION}"

# Non-root runtime user with a fixed UID so persistent volumes keep stable
# ownership across container restarts.
RUN groupadd -r speechkit --gid 2000 \
    && useradd -r -g speechkit --uid 2000 -m -d /home/speechkit speechkit \
    && mkdir -p /etc/speechkit /var/lib/speechkit/data /var/lib/speechkit/models \
    && chown -R speechkit:speechkit /etc/speechkit /var/lib/speechkit

# Local speech-to-text: speechkit-stt-sherpa ships next to the server binary
# in every image. The self-hosted image (target speechkit-server-selfhosted)
# adds Phonon-2.5 under /usr/local/share/speechkit/models, which the
# self-hosted defaults start when no STT endpoint and no cloud key are
# configured. whisper.cpp is not baked in; an operator who prefers it, or whose
# processor lacks AVX2, runs the whisper-server sidecar
# (deploy/docker/docker-compose.yml, profile whisper; install-server.sh adds it
# on such a host) and sets SPEECHKIT_SELFHOSTED_STT_URL.

USER speechkit
WORKDIR /home/speechkit

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD curl -fsS http://localhost:8080/healthz || exit 1

# ── Stage 3: server core (all three modes), shared by both targets ───────────
FROM runtime-base AS server-core

LABEL org.opencontainers.image.title="SpeechKit Server"
LABEL org.opencontainers.image.description="SpeechKit Framework — full server (Dictation, Assist, Voice Agent over HTTP/WebSocket)."
LABEL org.opencontainers.image.source="https://github.com/kombifyio/SpeechKit"
LABEL org.opencontainers.image.licenses="Apache-2.0"

COPY --from=builder /out/speechkit-server /app/speechkit-server
COPY --from=builder /out/speechkit-stt-sherpa /app/speechkit-stt-sherpa
COPY --from=builder /out/sherpa-onnx/ /usr/local/lib/sherpa-onnx/
# CONFIG_FILE selects which baked config ships in the image. Defaults to the
# providerless reference config (OSS unchanged); the kombify production build
# passes deploy/config/server.kombify-prod.toml without a separate Dockerfile.
ARG CONFIG_FILE=deploy/config/server.example.toml
COPY --chown=speechkit:speechkit ${CONFIG_FILE} /etc/speechkit/config.toml

# Entrypoint syncs wake-word models from R2 (when R2 creds are present) into the
# models volume, then execs the server. No R2 creds → sync skipped, server
# starts unchanged (OSS/local-only path).
COPY --chown=speechkit:speechkit deploy/docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Operators can wrap this image from the host or orchestrator; the image
# itself stays secret-manager neutral and works with any env-var injector.
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["--config=/etc/speechkit/config.toml"]

# ── Stage 4: speechkit-server-selfhosted (published self-host image) ────────
# The image ghcr.io/kombifyio/speechkit-server and the install E2E build: the
# server core plus the bundled Phonon-2.5 (stage 1b), so a fresh self-hosted
# install dictates locally with no STT container and no key.
FROM server-core AS speechkit-server-selfhosted

LABEL org.opencontainers.image.licenses="Apache-2.0 AND CC-BY-4.0"
COPY --from=phonon-model /out/phonon-2.5/ /usr/local/share/speechkit/models/phonon-2.5/

# ── Stage 5: speechkit-server (kombify production; default target) ──────────
# The production build (CONFIG_FILE=deploy/config/server.kombify-prod.toml),
# Early Access on Render (which builds the last stage) and any build without
# --target: the server core without a bundled model. It must stay the last
# stage.
FROM server-core AS speechkit-server
