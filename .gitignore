# Models (large files)
*.bin
*.ggml
/models/
.public-export*/

# Wake-word training artifacts (ONNX checkpoints + training logs land here,
# committed model assets go into tools/wakeword-training/*.yaml configs and
# the prepared bundle under wakeword-kws/ -- not the raw training output).
tools/wakeword-training/output/

