{
  "name": "speechkit-release",
  "private": true,
  "version": "0.28.2",
  "type": "module",
  "scripts": {
    "app:dev": "powershell -ExecutionPolicy Bypass -File ./start-dev.ps1",
    "app:dev:detached": "powershell -ExecutionPolicy Bypass -File ./start-dev.ps1 -NoWait",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "dev": "npm --prefix Website run dev --",
    "release:notes": "node ./scripts/release/render-release-notes.mjs",
    "release:notes:test": "node --test ./scripts/release/changelog.test.mjs",
    "website:build": "npm --prefix Website run build",
    "website:check": "npm --prefix Website run check",
    "website:dev": "npm --prefix Website run dev --",
    "website:install": "npm --prefix Website ci",
    "website:preview": "npm --prefix Website run preview --",
    "website:test": "npm --prefix Website run test",
    "version:sync": "node ./scripts/sync-version.mjs",
    "version:sync:windows": "node ./scripts/sync-version.mjs --targets=frontend,windows",
    "version:sync:android": "node ./scripts/sync-version.mjs --targets=android",
    "version:sync:all": "node ./scripts/sync-version.mjs --targets=frontend,windows,android",
    "version": "changeset version && npm run version:sync"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0"
  }
}
