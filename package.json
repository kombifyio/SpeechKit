{
  "name": "speechkit-release",
  "private": true,
  "version": "0.67.24",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "app:build": "npm --prefix frontend/app run build",
    "app:check": "npm --prefix frontend/app run check",
    "app:dev": "powershell -ExecutionPolicy Bypass -File ./start-dev.ps1",
    "app:dev:detached": "powershell -ExecutionPolicy Bypass -File ./start-dev.ps1 -NoWait",
    "app:lint": "npm --prefix frontend/app run lint",
    "app:test": "npm --prefix frontend/app test",
    "check": "npm run app:check",
    "deadcode": "knip --config knip.json --no-exit-code",
    "deadcode:strict": "knip --config knip.json",
    "release:notes": "node ./scripts/release/render-release-notes.mjs",
    "release:notes:test": "node --test ./scripts/release/changelog.test.mjs ./scripts/release/release-metadata.test.mjs",
    "release:website-one-shot": "node ./scripts/verify-website-one-shot-prompts.mjs",
    "release:cloudflare-quality-gate": "node ./scripts/cloudflare-quality-gate.mjs",
    "release:lint": "node ./scripts/release/lint-changelog.mjs",
    "release:lint:unreleased": "node ./scripts/release/lint-changelog.mjs --unreleased",
    "release:lint:version-sync": "node ./scripts/release/lint-version-sync.mjs",
    "release:lint:test": "node --test ./scripts/release/lint-changelog.test.mjs",
    "release:cloudflare-quality-gate:test": "node --test ./scripts/release/cloudflare-quality-gate.test.mjs",
    "ci:contract:test": "node --test ./scripts/ci/ci-required-check.test.mjs",
    "release:dry-run:private": "powershell -ExecutionPolicy Bypass -File ./scripts/private-release-dry-run.ps1",
    "quality:quick": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ci/quality-gate.ps1 -Suite quick",
    "quality:public": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ci/quality-gate.ps1 -Suite public",
    "quality:release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ci/quality-gate.ps1 -Suite release",
    "quality:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/ci/quality-gate.ps1 -Suite windows",
    "security:secrets": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/security/scan-tracked-secrets.ps1",
    "version:sync": "node ./scripts/sync-version.mjs",
    "version:sync:windows": "node ./scripts/sync-version.mjs --targets=frontend,windows",
    "version:sync:android": "node ./scripts/sync-version.mjs --targets=android",
    "version:sync:all": "node ./scripts/sync-version.mjs --targets=frontend,windows,android",
    "website:dev": "npm --prefix Website run dev",
    "website:install": "npm --prefix Website ci",
    "website:build": "npm --prefix Website run build",
    "website:check": "npm --prefix Website run check",
    "website:test": "npm --prefix Website test",
    "test": "npm run release:notes:test && npm run release:lint:test && npm run release:cloudflare-quality-gate:test && npm run app:test"
  },
  "devDependencies": {
    "knip": "^6.13.0"
  },
  "overrides": {
    "js-yaml": "^4.3.0"
  }
}
